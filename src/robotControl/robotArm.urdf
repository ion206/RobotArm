<?xml version="1.0"?>
<robot name="robot_arm">

  <!-- Fixed base stand -->
  <link name="base_stand">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.08" radius="0.02"/>
      </geometry>
    </visual>
  </link>

  <!-- Rotating base -->
  <link name="base">
    <visual>
      <origin xyz="0 0 0.005" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.01" radius="0.025"/>
      </geometry>
    </visual>
  </link>

  <!-- Z-axis rotation -->
  <joint name="base_joint" type="revolute">
    <parent link="base_stand"/>
    <child link="base"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57"/>
  </joint>

  <!-- Shoulder -->
  <link name="shoulder">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.12" radius="0.015"/>
      </geometry>
    </visual>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <parent link="base"/>
    <child link="shoulder"/>
    <origin xyz="0 0 0.01" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57"/>
  </joint>

  <!-- Elbow -->
  <link name="elbow">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.10" radius="0.015"/>
      </geometry>
    </visual>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="shoulder"/>
    <child link="elbow"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="3.14"/>
  </joint>

  <!-- Wrist -->
  <link name="wrist">
    <visual>
      <origin xyz="0 0 0.055" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.11" radius="0.015"/>
      </geometry>
    </visual>
  </link>

  <!-- Reoriented wrist joint: X-axis rotation -->
  <joint name="wrist_joint" type="revolute">
    <parent link="elbow"/>
    <child link="wrist"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14" upper="1.57"/>
  </joint>

</robot>
